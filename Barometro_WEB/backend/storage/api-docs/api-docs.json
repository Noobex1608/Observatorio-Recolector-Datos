                                        "example": "Breve descripción"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuario creado"
                    },
                    "401": {
                        "description": "No autenticado. Ejecuta /login y autoriza Swagger con el token Bearer."
