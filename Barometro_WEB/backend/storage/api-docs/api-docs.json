                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    },
                                    "rol": {
                                        "type": "string",
                                        "enum": [
                                            "SUPER_ADMIN",
                                            "ADMIN",
                                            "USER"
                                        ],
                                        "example": "USER"
                                    },
                                    "is_active": {
                                        "type": "boolean",
