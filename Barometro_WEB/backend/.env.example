APP_NAME="Observatorio ULEAM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:8100,https://incredible-cactus-e2cb5a.netlify.app,https://timely-druid-80b292.netlify.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL Docker Configuration
# Run: docker-compose up -d
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=observatorio_uleam
DB_USERNAME=postgres
DB_PASSWORD=secret123

# Swagger Configuration
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000/api

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

SUPABASE_URL=
SUPABASE_FORM_SCHEMA_SYNC_ENABLED=false
SUPABASE_RESPONSE_SYNC_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_SURVEYS_TABLE=surveys
SUPABASE_QUESTIONS_TABLE=questions
SUPABASE_RESPONSES_TABLE=responses
SUPABASE_MAX_RETRY_ATTEMPTS=12
SUPABASE_RETRY_BASE_SECONDS=30
SUPABASE_VIDEO_BUCKET=videos
SUPABASE_RESPONSE_MEDIA_BUCKET=response-media
SUPABASE_STORAGE_FILE_LIMIT=52428800
VIDEO_STORAGE_DRIVER=supabase
RESPONSE_MEDIA_DRIVER=supabase
RESPONSE_MEDIA_MAX_FILES=10
RESPONSE_MEDIA_MAX_FILE_BYTES=31457280
RESPONSE_MEDIA_MAX_TOTAL_BYTES=36700160

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================
# SEED CONFIGURATION (Required for /api/seed endpoints)
# ============================================
# Token de seguridad para ejecutar seeders via API
# IMPORTANTE: Cambia este valor por uno seguro y único
SEED_TOKEN=

# Credenciales del usuario administrador inicial
# IMPORTANTE: Usa una contraseña segura en producción
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
