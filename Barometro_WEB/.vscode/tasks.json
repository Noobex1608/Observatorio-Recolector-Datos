      "osx": { "command": "./scripts/frontend.sh start" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" },
      "isBackground": true,
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Instalar dependencias",
      "type": "shell",
      "windows": { "command": "powershell -ExecutionPolicy Bypass -File ./scripts/frontend.ps1 install" },
      "linux": { "command": "./scripts/frontend.sh install" },
      "osx": { "command": "./scripts/frontend.sh install" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Frontend: Build producción",
      "type": "shell",
      "windows": { "command": "powershell -ExecutionPolicy Bypass -File ./scripts/frontend.ps1 build" },
      "linux": { "command": "./scripts/frontend.sh build" },
      "osx": { "command": "./scripts/frontend.sh build" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Frontend: Ejecutar tests",
      "type": "shell",
      "windows": { "command": "powershell -ExecutionPolicy Bypass -File ./scripts/frontend.ps1 test" },
