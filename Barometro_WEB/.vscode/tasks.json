      "osx": { "command": "./scripts/backend.sh start" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" },
      "isBackground": true,
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      "label": "Backend: Detener servidor",
      "type": "shell",
      "windows": { "command": "powershell -ExecutionPolicy Bypass -File ./scripts/backend.ps1 stop" },
      "linux": { "command": "./scripts/backend.sh stop" },
      "osx": { "command": "./scripts/backend.sh stop" },
