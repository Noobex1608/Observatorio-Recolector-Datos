    {
      "label": "Frontend: Lint",
      "type": "shell",
      "windows": { "command": "powershell -ExecutionPolicy Bypass -File ./scripts/frontend.ps1 lint" },
      "linux": { "command": "./scripts/frontend.sh lint" },
      "osx": { "command": "./scripts/frontend.sh lint" },
      "group": "build",
      "problemMatcher": []
