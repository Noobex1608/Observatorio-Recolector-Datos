    // ==========================================
    // 🚀 COMPOUND TASKS
    // ==========================================
    {
      "label": "🚀 Iniciar TODO (Docker + Backend + Frontend)",
      "dependsOn": [
        "Docker: Iniciar PostgreSQL",
        "Backend: Iniciar servidor",
        "Frontend: Iniciar servidor dev"
      ],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "⏹️ Detener TODO",
      "dependsOn": ["Backend: Detener servidor", "Docker: Detener PostgreSQL"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "🔧 Setup inicial (Instalar + Migrar)",
      "dependsOn": [
        "Docker: Iniciar PostgreSQL",
        "Backend: Instalar dependencias",
        "Frontend: Instalar dependencias",
        "Backend: Ejecutar migraciones"
      ],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
