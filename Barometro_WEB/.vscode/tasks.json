    {
      "label": "Backend: Ver rutas API",
      "type": "shell",
      "windows": { "command": "powershell -ExecutionPolicy Bypass -File ./scripts/backend.ps1 routes" },
      "linux": { "command": "./scripts/backend.sh routes" },
      "osx": { "command": "./scripts/backend.sh routes" },
      "group": "build",
      "problemMatcher": []
