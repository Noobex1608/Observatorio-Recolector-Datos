{
  "version": "2.0.0",
  "tasks": [
    // ==========================================
    // 🐳 DOCKER
    // ==========================================
    {
      "label": "Docker: Iniciar PostgreSQL",
      "type": "shell",
      "windows": { "command": "powershell -ExecutionPolicy Bypass -File ./scripts/docker.ps1 up" },
      "linux": { "command": "./scripts/docker.sh up" },
      "osx": { "command": "./scripts/docker.sh up" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Docker: Detener PostgreSQL",
      "type": "shell",
      "windows": { "command": "powershell -ExecutionPolicy Bypass -File ./scripts/docker.ps1 down" },
      "linux": { "command": "./scripts/docker.sh down" },
      "osx": { "command": "./scripts/docker.sh down" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Docker: Ver logs PostgreSQL",
      "type": "shell",
      "windows": { "command": "powershell -ExecutionPolicy Bypass -File ./scripts/docker.ps1 logs" },
      "linux": { "command": "./scripts/docker.sh logs" },
      "osx": { "command": "./scripts/docker.sh logs" },
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker: Reiniciar PostgreSQL",
      "type": "shell",
      "windows": { "command": "powershell -ExecutionPolicy Bypass -File ./scripts/docker.ps1 restart" },
      "linux": { "command": "./scripts/docker.sh restart" },
      "osx": { "command": "./scripts/docker.sh restart" },
      "group": "build",
      "problemMatcher": []
    },

    // ==========================================
    // 🔧 BACKEND (Laravel)
    // ==========================================
    {
      "label": "Backend: Iniciar servidor",
